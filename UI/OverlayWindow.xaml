<Window x:Class="GameKeyMaster.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameKeyMaster Overlay" Height="100" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" IsHitTestVisible="False"
        Loaded="Window_Loaded">
    <Grid>
        <Border Background="#CC000000" CornerRadius="10" Padding="15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <TextBlock x:Name="MessageText" Text="GameKeyMaster Aktif: Profil Adı" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </Border>
    </Grid>
</Window>
