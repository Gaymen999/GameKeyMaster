<Window x:Class="GameKeyMaster.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameKeyMaster Badge" Height="40" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Grid>
        <Border Background="#CC1E1E1E" CornerRadius="20" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#007ACC" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#27AE60" Margin="0,0,8,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock x:Name="MessageText" Text="SİSTEM AKTİF" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
