<Window x:Class="GameKeyMaster.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameKeyMaster v1.0.4" Height="650" Width="1000"
        Background="#121212" Foreground="#E0E0E0" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Semibold">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Game List -->
        <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="GAME KEY MASTER" FontWeight="ExtraBold" FontSize="20" Foreground="#007ACC"/>
                    <TextBlock Text="Profesyonel Tuş Yönetimi" FontSize="11" Foreground="#888" Margin="2,0,0,0"/>
                </StackPanel>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" 
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,15"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,10" CornerRadius="8" Margin="0,4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D"/>
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding ExecutableName}" FontSize="10" Foreground="#666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Button Content="+ Yeni Oyun Ekle" Background="#007ACC" Foreground="White" 
                            Padding="12" BorderThickness="0" Cursor="Hand" Click="AddGame_Click" Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Seçili Oyunu Sil" Background="Transparent" Foreground="#E74C3C" 
                            Padding="8" BorderThickness="1" BorderBrush="#444" Cursor="Hand" Click="DeleteGame_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='OYUN SEÇİLMEDİ'}" FontSize="32" FontWeight="Black"/>
                    <Border Background="#252525" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="#F1C40F" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="SİSTEMİ BAŞLAT" Background="#27AE60" Foreground="White" Padding="20,12" 
                            FontWeight="Bold" Margin="0,0,10,0" Click="StartSystem_Click" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="DURDUR" Background="#C0392B" Foreground="White" Padding="20,12" 
                            FontWeight="Bold" Click="StopSystem_Click" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs with Cards -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,30,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Padding="15,8" Margin="0,0,10,0" BorderThickness="0,0,0,2">
                                        <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="#888"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                
                <TabItem Header="TUŞ EŞLEME">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedGame.Mappings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E1E" Width="180" Height="100" Margin="0,0,15,15" CornerRadius="10" Padding="15">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InputKey}" FontWeight="Black" FontSize="18" Foreground="#007ACC" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="➔" FontSize="12" Foreground="#444" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <TextBlock Text="{Binding OutputKey}" FontWeight="Black" FontSize="18" Foreground="#27AE60" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#555" Click="DeleteMapping_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="1" Content="+ Yeni Eşleme Ekle" HorizontalAlignment="Left" Padding="15,10" Margin="0,10,0,0" Click="AddMapping_Click" Background="#2D2D2D" Foreground="#007ACC" BorderThickness="1" BorderBrush="#444">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </TabItem>
                
                <TabItem Header="MAKROLAR">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedGame.Macros}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E1E" Width="220" Height="100" Margin="0,0,15,15" CornerRadius="10" Padding="15">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InputKey}" FontWeight="Black" FontSize="18" Foreground="#E67E22" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Actions.Count, StringFormat='{0} Adım'}" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="#555" Click="DeleteMacro_Click" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="1" Content="+ Yeni Makro Ekle" HorizontalAlignment="Left" Padding="15,10" Margin="0,10,0,0" Click="AddMacro_Click" Background="#2D2D2D" Foreground="#E67E22" BorderThickness="1" BorderBrush="#444">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#331A1A" BorderBrush="#C0392B" BorderThickness="1" CornerRadius="8" Padding="15">
                <TextBlock Text="⚠ GÜVENLİK UYARISI: Bu yazılım doğrudan girdi simülasyonu kullanır. Bazı rekabetçi oyunlarda kullanım riskli olabilir. Her zaman en güncel sürümü ve makul gecikme (delay) sürelerini kullanın." 
                           Foreground="#E74C3C" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>
