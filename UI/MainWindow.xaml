<Window x:Class="GameKeyMaster.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameKeyMaster - Erişilebilir Oyun Başlatıcı" Height="600" Width="900"
        Background="#121212" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Panel: Oyun Listesi -->
        <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="OYUNLARIM" FontWeight="Bold" FontSize="18" Foreground="#007ACC" Margin="0,0,0,15"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" 
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="5" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding ExecutableName}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="+ Yeni Oyun Ekle" Background="#007ACC" Foreground="White" 
                        Padding="10" BorderThickness="0" Cursor="Hand" Click="AddGame_Click"/>
            </Grid>
        </Border>

        <!-- Sağ Panel: Ayarlar ve Kontrol -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Üst Başlık ve Durum -->
            <StackPanel>
                <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='Lütfen Oyun Seçin'}" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}" Foreground="Orange" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Detay Sekmeleri -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,20,0,0">
                <TabItem Header="Tuş Eşleme">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ListView ItemsSource="{Binding SelectedGame.Mappings}" Background="#1E1E1E" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Fiziksel Tuş" DisplayMemberBinding="{Binding InputKey}" Width="120"/>
                                    <GridViewColumn Header="Oyun Tuşu" DisplayMemberBinding="{Binding OutputKey}" Width="120"/>
                                    <GridViewColumn Header="Yutma" DisplayMemberBinding="{Binding SuppressOriginal}" Width="80"/>
                                    <GridViewColumn Header="" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Sil" Background="#CC0000" Foreground="White" BorderThickness="0" Click="DeleteMapping_Click" Padding="5,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Yeni Eşleme Ekle" Padding="15,8" Click="AddMapping_Click" Margin="0,0,10,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Makrolar">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ListView ItemsSource="{Binding SelectedGame.Macros}" Background="#1E1E1E" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tetikleyici Tuş" DisplayMemberBinding="{Binding InputKey}" Width="120"/>
                                    <GridViewColumn Header="Yutma" DisplayMemberBinding="{Binding SuppressOriginal}" Width="60"/>
                                    <GridViewColumn Header="Adım Sayısı" DisplayMemberBinding="{Binding Actions.Count}" Width="80"/>
                                    <GridViewColumn Header="" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Sil" Background="#CC0000" Foreground="White" BorderThickness="0" Click="DeleteMacro_Click" Padding="5,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Yeni Makro Ekle" Padding="15,8" Click="AddMacro_Click" Margin="0,0,10,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Alt Kontrol Barı -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="#333" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Sistemi Başlat" Background="#2ECC71" Foreground="White" Padding="20,10" 
                            FontWeight="Bold" Margin="0,0,10,0" Click="StartSystem_Click"/>
                    <Button Content="Durdur" Background="#E74C3C" Foreground="White" Padding="20,10" 
                            FontWeight="Bold" Click="StopSystem_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
