<Window x:Class="GameKeyMaster.UI.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuş Yakalanıyor" Height="150" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Border Background="#222" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="10">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Tuş Bekleniyor..." FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CapturedKeyText" Text="Lütfen bir tuşa basın" FontSize="14" Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <Button Content="İptal" Margin="0,15,0,0" Padding="10,5" Click="Cancel_Click" Background="#444" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
